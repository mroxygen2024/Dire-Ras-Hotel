generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPERADMIN
  EDITOR
  VIEWER
}

enum RoomType {
  STANDARD
  DELUXE
  SUITE
  PRESIDENTIAL
}

model Admin {
  id        String    @id @default(uuid()) @db.Uuid
  email     String    @unique
  password  String
  firstName String?
  lastName  String?
  role      AdminRole @default(EDITOR)
  isActive  Boolean   @default(true)
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  @@index([email])
  @@index([isDeleted])
}

model HotelInfo {
  id                    String    @id @default(uuid()) @db.Uuid
  name                  String
  logoUrl               String?
  tagline               String?
  address               String
  email                 String
  phone                 String
  phone2                String?
  whatsappNumber        String?
  establishedText       String?
  mapEmbedUrl           String?
  facebookUrl           String?
  instagramUrl          String?
  twitterUrl            String?
  tripAdvisorUrl        String?
  
  // Footer configuration fields
  footerTagline         String?   @default("Serving eastern Ethiopia with legacy hospitality")
  footerDescription     String?   @default("Dire Dawa Ras Hotel is a legendary monument of hospitality and landmark luxury.")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // 1-to-1 Page configurations for modular CMS control
  heroSection     HeroSection?
  heritageSection HeritageSection?
  aboutPage       AboutPage?
  whyStaySection  WhyStaySection?
  reviewSection   ReviewSection?
  contactPage     ContactPage?

  // 1-to-many operational relationships
  services       Service[]
  rooms          Room[]
  reviews        Review[]
  navigationMenu NavigationMenu?
  sectionConfigs SectionConfig[]

  @@index([isDeleted])
}

model HeroSection {
  id              String   @id @default(uuid()) @db.Uuid
  hotelId         String   @unique @db.Uuid
  badgeText       String?
  subtitle        String?
  titlePart1      String
  titlePart2      String?
  tagline         String?
  ctaBookText     String?
  ctaVideoText    String?
  videoUrl        String?
  backgroundImage String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotel       HotelInfo @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
}

model HeritageSection {
  id              String   @id @default(uuid()) @db.Uuid
  hotelId         String   @unique @db.Uuid
  title           String
  slogan          String?
  description     String
  badgeUrl        String?
  bgImageUrl      String?
  establishedYear Int?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hotel           HotelInfo @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
}

model AboutPage {
  id           String   @id @default(uuid()) @db.Uuid
  hotelId      String   @unique @db.Uuid
  title        String
  subtitle     String?
  mainImageUrl String?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hotel        HotelInfo @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  
  // 1-to-many modular components of the about page
  stories      StorySection[]
  events       TimelineEvent[]

  @@index([hotelId])
}

model StorySection {
  id           String   @id @default(uuid()) @db.Uuid
  aboutPageId  String   @db.Uuid
  title        String
  description  String
  imageUrl     String?
  order        Int      @default(0)
  alignRight   Boolean  @default(false)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  aboutPage    AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)

  @@index([aboutPageId])
  @@index([order])
}

model TimelineEvent {
  id          String   @id @default(uuid()) @db.Uuid
  aboutPageId String   @db.Uuid
  year        String
  title       String
  description String
  order       Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  aboutPage   AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)

  @@index([aboutPageId])
  @@index([order])
}

model WhyStaySection {
  id        String   @id @default(uuid()) @db.Uuid
  hotelId   String   @unique @db.Uuid
  title     String
  subtitle  String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel     HotelInfo @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  features  WhyStayFeature[]

  @@index([hotelId])
}

model WhyStayFeature {
  id               String   @id @default(uuid()) @db.Uuid
  whyStaySectionId String   @db.Uuid
  icon             String
  title            String
  description      String
  order            Int      @default(0)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  whyStaySection   WhyStaySection @relation(fields: [whyStaySectionId], references: [id], onDelete: Cascade)

  @@index([whyStaySectionId])
  @@index([order])
}

model Service {
  id          String    @id @default(uuid()) @db.Uuid
  hotelId     String    @db.Uuid
  title       String
  description String
  icon        String?
  order       Int       @default(0)
  isAvailable Boolean   @default(true)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?

  hotel       HotelInfo @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@index([order])
  @@index([isAvailable])
  @@index([isDeleted])
}

model Room {
  id            String    @id @default(uuid()) @db.Uuid
  hotelId       String    @db.Uuid
  name          String
  price         Decimal   @db.Decimal(10, 2)
  currency      String    @default("USD")
  image         String
  description   String
  size          String?
  occupancy     Int       @default(2)
  bed           String?
  features      Json      @default("[]")
  featured      Boolean   @default(false)
  isAvailable   Boolean   @default(true)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?

  hotel         HotelInfo @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@index([featured])
  @@index([isAvailable])
  @@index([isDeleted])
}

model ReviewSection {
  id        String   @id @default(uuid()) @db.Uuid
  hotelId   String   @unique @db.Uuid
  badge     String?
  title     String
  subtitle  String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel     HotelInfo @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reviews   Review[]

  @@index([hotelId])
}

model Review {
  id              String    @id @default(uuid()) @db.Uuid
  hotelId         String    @db.Uuid
  reviewSectionId String?   @db.Uuid
  name            String
  platform        String?
  text            String
  rating          Int       @default(5)
  isApproved      Boolean   @default(true)
  isFeatured      Boolean   @default(false)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?

  hotel           HotelInfo @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reviewSection   ReviewSection? @relation(fields: [reviewSectionId], references: [id], onDelete: SetNull)

  @@index([hotelId])
  @@index([reviewSectionId])
  @@index([rating])
  @@index([isApproved])
  @@index([isFeatured])
  @@index([isDeleted])
}

model ContactPage {
  id           String   @id @default(uuid()) @db.Uuid
  hotelId      String   @unique @db.Uuid
  title        String
  subtitle     String?
  introText    String?
  formTitle    String?
  nameLabel    String?
  emailLabel   String?
  phoneLabel   String?
  msgLabel     String?
  submitBtn    String?
  description  String?
  phone        String?
  email        String?
  whatsappLink String?
  latitude     Float?
  longitude    Float?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hotel        HotelInfo @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
}

model NavigationMenu {
  id        String   @id @default(uuid()) @db.Uuid
  hotelId   String   @unique @db.Uuid
  isActive  Boolean  @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel     HotelInfo @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  items     NavigationItem[]

  @@index([hotelId])
}

model NavigationItem {
  id              String   @id @default(uuid()) @db.Uuid
  navigationMenuId String @db.Uuid
  label           String
  page            String   // 'home', 'about', 'rooms', 'contact'
  section         String?  // Optional section for same-page navigation
  order           Int      @default(0)
  isVisible       Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  navigationMenu  NavigationMenu @relation(fields: [navigationMenuId], references: [id], onDelete: Cascade)

  @@index([navigationMenuId])
  @@index([order])
}

model SectionConfig {
  id        String   @id @default(uuid()) @db.Uuid
  hotelId   String   @db.Uuid
  sectionKey String  // 'rooms', 'why-stay', 'reviews', 'services', 'about' etc.
  badge     String?
  title     String?
  subtitle  String?
  description String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel     HotelInfo @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, sectionKey])
  @@index([hotelId])
  @@index([sectionKey])
}
